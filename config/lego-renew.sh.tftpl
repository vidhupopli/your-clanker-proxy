#!/bin/bash
# Daily Let's Encrypt renew. Invoked by systemd. Do not set -x: never print keys.
set -euo pipefail

DOMAIN_NAME='${domain_name}'
ACME_EMAIL='${acme_email}'
HOSTED_ZONE_ID='${hosted_zone_id}'
PROXY_DIR=/opt/proxy
LEGO_BIN=/opt/proxy/bin/lego
LEGO_PATH=/opt/proxy/lego
HAPROXY_IMAGE='haproxy:3.0@sha256:9e3eda7a75ff9b51a8b8f90054aa6d39a7505702d610ebd308a1477bd074b176'

log() { echo "lego-renew: $*"; }

if [ -z "$DOMAIN_NAME" ]; then
  log "domain_name empty; nothing to renew"
  exit 0
fi

if [ ! -x "$LEGO_BIN" ]; then
  log "lego binary missing; skip"
  exit 1
fi

imds_token() {
  curl -fsS -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 21600"
}
TOKEN="$(imds_token)"
REGION="$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/placement/region)"
export AWS_DEFAULT_REGION="$REGION"
export AWS_REGION="$REGION"
if [ -n "$HOSTED_ZONE_ID" ]; then
  export AWS_HOSTED_ZONE_ID="$HOSTED_ZONE_ID"
fi

log "start $(date -u +%FT%TZ) domain=$DOMAIN_NAME"

# Keep the live pem if renew fails.
if ! "$LEGO_BIN" --accept-tos --email "$ACME_EMAIL" --dns route53 \
    --domains "$DOMAIN_NAME" --path "$LEGO_PATH" renew --days 30; then
  log "lego renew failed; keeping previous HAProxy pem"
  exit 1
fi

crt="$LEGO_PATH/certificates/$${DOMAIN_NAME}.crt"
key="$LEGO_PATH/certificates/$${DOMAIN_NAME}.key"
issuer="$LEGO_PATH/certificates/$${DOMAIN_NAME}.issuer.crt"
if [ ! -f "$crt" ] || [ ! -f "$key" ]; then
  log "lego did not write crt/key; keeping previous pem"
  exit 1
fi

umask 077
le_new="$PROXY_DIR/haproxy.pem.le.new"
: > "$le_new"
cat "$crt" >> "$le_new"
if [ -f "$issuer" ]; then
  cat "$issuer" >> "$le_new"
fi
cat "$key" >> "$le_new"
chmod 0644 "$le_new"

log "validating haproxy cfg with renewed pem"
docker run --rm \
  -v "$PROXY_DIR/haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro" \
  -v "$le_new:/usr/local/etc/haproxy/haproxy.pem:ro" \
  "$HAPROXY_IMAGE" \
  haproxy -c -f /usr/local/etc/haproxy/haproxy.cfg

# Overwrite in place so the bind-mount inode stays valid.
cat "$le_new" > "$PROXY_DIR/haproxy.pem"
rm -f "$le_new"
chmod 0644 "$PROXY_DIR/haproxy.pem"

cd "$PROXY_DIR"
docker compose -f "$PROXY_DIR/docker-compose.yml" up -d --force-recreate

log "done $(date -u +%FT%TZ)"
